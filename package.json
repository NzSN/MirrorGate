{
  "name": "mirrorgate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.15.0" },
  "exports": {
    "./control": {
      "types": "./sdk/node/control.d.mts",
      "import": "./sdk/node/control.mjs"
    },
    "./worker": {
      "types": "./sdk/node/worker.d.mts",
      "import": "./sdk/node/index.mjs"
    },
    "./hosting-tool": {
      "types": "./integrations/agent-host/index.d.mts",
      "import": "./integrations/agent-host/index.mjs"
    }
  },
  "files": [
    "sdk/node/*.mjs",
    "sdk/node/*.d.mts",
    "sdk/node/README.md",
    "sdk/compatibility.json",
    "integrations/agent-host/*.mjs",
    "integrations/agent-host/*.d.mts",
    "integrations/agent-host/README.md"
  ],
  "scripts": {
    "test": "node --test tests/node/*.test.mjs tests/integration/*.test.mjs",
    "conformance": "node conformance/run.mjs && node conformance/lifecycle.mjs",
    "test:evaluator": "node integrations/mirrorecma/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "bin": {
    "mirrorgate-hosting-tool": "integrations/agent-host/cli.mjs"
  }
}
