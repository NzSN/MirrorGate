{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "isolatedModules": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
