{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorgate.invalid/protocol/v1/response.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ok": {
          "const": true
        },
        "result": {}
      },
      "required": [
        "v",
        "id",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])"
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
