{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorgate.invalid/protocol/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mirrorgate.port/v1"
    },
    "interfaceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "initializers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
                },
                "type": {
                  "$ref": "#/$defs/modelType"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "inputs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
                },
                "type": {
                  "$ref": "#/$defs/modelType"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "inputs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
          },
          "type": {
            "$ref": "#/$defs/modelType"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "interfaceDigest",
    "initializers",
    "actions",
    "observations"
  ],
  "additionalProperties": false,
  "$defs": {
    "modelType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "int",
                "bool",
                "str",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "set",
                "seq"
              ]
            },
            "element": {
              "$ref": "#/$defs/modelType"
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/modelType"
              },
              "minItems": 0
            }
          },
          "required": [
            "kind",
            "elements"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "record"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "wireName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "type": {
                    "$ref": "#/$defs/modelType"
                  }
                },
                "required": [
                  "wireName",
                  "type"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "kind",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "map"
            },
            "key": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "str"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            "value": {
              "$ref": "#/$defs/modelType"
            }
          },
          "required": [
            "kind",
            "key",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "variant"
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "payload": {
                    "$ref": "#/$defs/modelType"
                  }
                },
                "required": [
                  "tag",
                  "payload"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "cases"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
